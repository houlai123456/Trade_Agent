# DeepSeek API Key（必填）
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 阿里云 DashScope API Key（必填，用于 Embedding）
# 申请地址: https://dashscope.aliyun.com/
ALIYUN_API_KEY=your_aliyun_api_key_here

# 飞书消息推送（选填，不填则不推送）
# 申请地址: https://open.feishu.cn/ 创建企业自建应用，只需开 im:message:send_as_bot 权限
# target-open-id 获取: 飞书开放平台 → API调试台 → 搜索"获取用户ID"
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_TARGET_OPEN_ID=your_feishu_open_id
